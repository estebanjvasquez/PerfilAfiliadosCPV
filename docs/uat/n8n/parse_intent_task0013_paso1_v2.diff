+      const stem = (t) => t.replace(/(es|s)$/, '');
+      if (fWords.length > 1 && !fWords.some((t) => FILLER.has(t)) && fWords.some((t) => stem(t) === stem(qWords[0]))) {
+        queryRestoredFrom = parsed.params.query;
+        parsed.params.query = full.trim();
+      }
+    }
+    // "query" va sin tildes: si la frase original las tenia, sigue en resolvedPhrases y el Worker
+    // busca las dos variantes (mismo efecto que tenia el flujo anterior, medido en "camion chupon").
+    const plain = parsed.params.query.normalize('NFD').replace(/[\u0300-\u036f]/g, '');
+    if (plain !== parsed.params.query) {
+      const original = parsed.params.query;
+      parsed.params.query = plain;
+      queryAccentsStripped = true;
+      if (!phrases.some((f) => typeof f === 'string' && f.trim() === original.trim())) {
+        parsed.params.resolvedPhrases = [...phrases, original];
+      }
+    }
+  }
+
   const paramsWithIntent = parsed.tool === 'search_empresas'
     ? { ...parsed.params, queryIntent: queryIntentClean }
