# CPV — plantilla del almacen local de credenciales
#
# ============================================================================
#  ESTE ARCHIVO ES UNA PLANTILLA Y ESTA EN UN REPOSITORIO PUBLICO.
#  NO ESCRIBIR NINGUN VALOR AQUI. Solo nombres.
# ============================================================================
#
# Copiar a la ubicacion REAL, que esta FUERA del repositorio:
#
#   %USERPROFILE%\.cpv\credentials.env
#
# y rellenar los valores alli. Ver docs/orquestador/ACCESS_BOOTSTRAP.md seccion 3.
#
# Cargarlo en una sesion con:
#   . docs\orquestador\bootstrap_access.ps1 -Quiet
#
# Todas las entradas son OPCIONALES: lo que falte simplemente deshabilita esa
# capacidad, y bootstrap_access.ps1 lo reporta como MISSING sin fallar.


# --- GitHub -----------------------------------------------------------------
# PAT para ESCRIBIR comentarios en Issue #2. Scope minimo: public_repo
# (o repo si el repositorio pasa a privado). Conviene que sea un token
# DISTINTO del que usa `git push`, con caducidad corta.
# Leer Issue #2 NO necesita token mientras el repo sea publico.
CPV_GITHUB_TOKEN=

# --- Cloudflare / Worker ----------------------------------------------------
# Solo si una tarea autorizada necesita desplegar el Worker con wrangler.
# NOTA: DEBUG_TOKEN NO va aqui. Vive como secret del Worker en Cloudflare y su
# plaintext no es recuperable; usarlo/rotarlo es GATE D.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# --- Supabase ---------------------------------------------------------------
# Opcional, para verificacion de estado vivo en SOLO LECTURA.
SUPABASE_ACCESS_TOKEN=

# --- Base de datos ----------------------------------------------------------
# Normalmente NO hace falta duplicarlos aqui: `artisan` ya los lee del .env del
# repo. Rellenar solo si se van a usar scripts o psql fuera de Laravel.
# ATENCION: estos valores apuntan a la MISMA base que usa staging.
DB_PGSQL_HOST=
DB_PGSQL_PORT=
DB_PGSQL_DATABASE=
DB_PGSQL_USERNAME=
DB_PGSQL_PASSWORD=
DB_PGSQL_SSLMODE=
