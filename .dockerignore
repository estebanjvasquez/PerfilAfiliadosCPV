# Build context of the serving image (Dockerfile). The image must be built from SOURCE only: no
# configuration, credentials, repository metadata, host-generated state or private evidence may reach a
# layer. Runtime configuration comes from the deployment environment (`env_file` in docker-compose.yml),
# never from the image. See docs/deploy/IMAGEN_Y_SECRETOS.md.
#
# A file that reaches ANY layer stays in the image even if a later layer deletes it, so exclusion has to
# happen here, before COPY. The Dockerfile additionally fails the build if one of the critical paths
# below shows up anyway.

# --- Repository metadata and tooling --------------------------------------------------------------
.git
**/.git
.github
.claude
.idea
.vscode
.cpanel.yml
.styleci.yml
.editorconfig

# --- Environment files and credentials: every variant, at any depth -------------------------------
# Only the name template .env.example may enter (it holds no values).
.env
.env.*
**/.env
**/.env.*
!.env.example
auth.json
**/auth.json
*.key
**/*.key
*.pem
**/*.pem
*.p12
**/*.p12
*.pfx
**/*.pfx
*.ppk
**/*.ppk
**/id_rsa*
**/id_ed25519*
**/*credential*
**/*secret*
**/*.secret

# --- Backups, dumps and logs -----------------------------------------------------------------------
**/*.sql
**/*.sql.gz
**/*.dump
**/*.bak
**/*.backup
**/*.orig
**/*.swp
**/*~
**/*.log
**/error_log
composer.json-*
composer.lock-*
*.js-bk

# --- Dependencies and generated state (rebuilt in the image or mounted at runtime) -----------------
vendor
node_modules
public/hot
public/storage
bootstrap/cache/*
!bootstrap/cache/.gitignore
storage/app/*
!storage/app/.gitignore
!storage/app/public
storage/app/public/*
!storage/app/public/.gitignore
storage/framework/cache/*
!storage/framework/cache/.gitignore
!storage/framework/cache/data
storage/framework/cache/data/*
!storage/framework/cache/data/.gitignore
storage/framework/sessions/*
!storage/framework/sessions/.gitignore
storage/framework/testing/*
!storage/framework/testing/.gitignore
storage/framework/views/*
!storage/framework/views/.gitignore
storage/logs/*
!storage/logs/.gitignore
.phpunit.result.cache
.phpunit.cache

# --- Contexts unrelated to serving -----------------------------------------------------------------
audit
tests
docs
docker/test
phpunit.xml
*.docx
